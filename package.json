{
  "name": "crossover",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:garmin": "tsx sync/garmin.ts",
    "sync:google": "tsx sync/google.ts",
    "sync:normalise": "tsx sync/normalise.ts",
    "sync": "tsx sync/garmin.ts && tsx sync/google.ts && tsx sync/normalise.ts && tsx sync/build.ts",
    "typecheck": "tsc --noEmit",
    "sync:build": "tsx sync/build.ts",
    "build": "tsx sync/normalise.ts && tsx sync/build.ts",
    "test": "tsx --test engine/test/*.test.ts",
    "dev": "vite",
    "preview": "vite preview",
    "build:app": "vite build"
  },
  "devDependencies": {
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "d3-shape": "^3.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
